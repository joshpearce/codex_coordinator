# Copy this file and replace the paths with absolute paths on this host.
codex_command = "codex"
# socket_path is optional; the host user's standard Codex socket is the default.
# worker_model and worker_reasoning_effort are optional overrides.

[projects]
# A third project is needed only for `make live-e2e` parent/monitor mode.
coordination = "/absolute/path/to/coordination-workspace"
# Existing child directories. Each child inherits the Codex configuration that
# naturally applies at its path, including danger-full-access/never-approve.
inventory-app = "/absolute/path/to/inventory-app"
inventory-report = "/absolute/path/to/inventory-report"
