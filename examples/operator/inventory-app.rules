# Commands the coordinator decides for the inventory-app worker without a judge.
#
# Syntax is the prefix_rule form of Codex CLI 0.154.0's execpolicy, so the file
# can be linted with `codex execpolicy check --rules <this file> <command...>`.
# The Codex runtime never loads it: it lives beside operator.toml, outside every
# worker- and coordinator-writable root, and the coordinator evaluates it itself
# before a request would reach a judge. A pattern is an argv prefix; a list
# inside it is a set of alternatives. Only decision = "allow" is accepted, since
# every command no rule allows already reaches a judge.
#
# The coordinator's evaluation is stricter than the runtime's: it unwraps the
# `<shell> -lc "<script>"` wrapper, evaluates every simple command in a
# `&&`, `;`, `|`, newline, or `if ... then exit 1; fi` chain, requires each one to
# match a rule, requires every argument to resolve inside the project, and hands
# anything it cannot fully parse to a judge. A rule still admits every mode of
# the program it names within the project, so name programs whose whole
# behavior inside the project you are willing to leave unjudged. `find` is
# deliberately absent: with `-exec` it runs an arbitrary program per match.
# The `match` and `not_match` examples are checked at startup and by the Codex
# linter alike, so they must be decided by the argv prefix alone; the
# coordinator's path containment is covered by its own test suite.
#
# File changes are not commands. Inside its own project a worker edits by right:
# a change whose every path normalizes inside the project is accepted by code,
# under a sandbox that already makes that project the only writable root with no
# network. To send particular in-project paths to a judge anyway, name them with
# the reserved program `codex-coordinator-file-change` and decision "prompt" --
# a file, or a directory and everything beneath it, relative to the project:
#
#     prefix_rule(
#         pattern = ["codex-coordinator-file-change", ["test_inventory_app.py", "pyproject.toml"]],
#         decision = "prompt",
#         justification = "the supplied tests and packaging are reviewed before they change",
#     )
#
# This project names none, so every in-project change is decided by containment.
# The reserved name is not a program: no rule may allow it, and a command
# spelled that way is judged like any other unmatched command.
prefix_rule(
    pattern = ["sed", "-n"],
    decision = "allow",
    justification = "range reads of the project's own files",
    match = [["sed", "-n", "1,240p", "README.md"]],
    not_match = [["sed", "-i", "s/a/b/", "README.md"]],
)
prefix_rule(
    pattern = ["rg"],
    decision = "allow",
    justification = "searches within the project",
    match = [["rg", "-n", "TODO", ".", "--hidden", "-g", "!/.git"]],
    not_match = [["find", ".", "-type", "f", "-exec", "rg", "TODO", "{}", ";"]],
)
prefix_rule(
    pattern = [["python", "python3"], "-m", "unittest"],
    decision = "allow",
    justification = "the project's own supplied test suite",
    match = [["python", "-m", "unittest", "-q"]],
    not_match = [["python", "-c", "print(1)"]],
)
prefix_rule(
    pattern = [["python", "python3"], "-m", "inventory_app", "--help"],
    decision = "allow",
    justification = "the project's own CLI entry point, usage only",
    match = [["python", "-m", "inventory_app", "--help"]],
    not_match = [["python", "-m", "inventory_app", "--file", "/tmp/x.json", "list"]],
)
prefix_rule(
    pattern = [["python", "python3"], "-m", "venv", ".venv"],
    decision = "allow",
    justification = "the project-local environment its dependencies restore into",
    match = [["python3", "-m", "venv", ".venv"]],
    not_match = [["python3", "-m", "venv", "/tmp/elsewhere"]],
)
# The install itself is deliberately not allowed here. It runs as
# `.venv/bin/python -m pip install -r requirements.txt`, and this file may not
# name a program by path: a worker can write `.venv/bin/python` inside its own
# project, so a path-based rule would let it supply the program it is allowed to
# run. Restoring dependencies therefore reaches a judge, and what the restore
# can actually contact is settled by the project's network ceiling regardless of
# what the judge decides.
# A manifest this project can edit is not a declaration on its own. Restoring
# what the project already declares is ordinary work, so a worker that could
# silently add a line could declare anything and then restore it as though the
# operator had asked for it. Changes to the declared set therefore reach a
# judge, while every other in-project change stays decided by containment.
prefix_rule(
    pattern = ["codex-coordinator-file-change", ["requirements.txt", "requirements-dev.txt"]],
    decision = "prompt",
    justification = "the declared dependency set is reviewed before it changes",
)
